{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moses-sh",
  "compatibility_date": "2026-10-01",
  // Production uses only the custom domain; preview locally with hugo server.
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "moses.sh", "custom_domain": true }]
}
